{
  "name": "cortes-water",
  "version": "1.0.0",
  "description": "Charts of lake-monitoring data for Gunflint and Hague lakes, Cortes Island",
  "scripts": {
    "prestart": "npm run merge-data",
    "start": "five-server --root=src --open=false",
    "merge-data": "node scripts/merge-data.js",
    "prebuild": "npm run merge-data",
    "build": "rm -rf dist && mkdir -p dist && cp -r src/* dist/ && echo 'Build complete'",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "five-server": "^0.5.0",
    "prettier": "^3.9.9"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
