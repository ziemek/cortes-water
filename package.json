    "build": "rm -rf dist && mkdir -p dist && cp -r src/* dist/ && echo 'Build complete'",
    "clean": "rm -rf dist",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
